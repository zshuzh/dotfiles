#!/usr/bin/env bash

if [ -L "$HOME/.zshrc" ] && [ "$(readlink -f "$HOME/.zshrc")" = "$HOME/.config/zsh/.zshrc" ]; then
    echo "[ZSH]: $HOME/.zshrc is already symlinked to $HOME/.config/zsh/.zshrc"
else
    if [[ -e "$HOME/.zshrc" ]]; then
        echo "[ZSH]: 🚨 $HOME/.zshrc already exists and must be deleted 🚨"
        read -p "are you sure you want to proceed? (y/n): " -n 1 -r
        echo

        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 1
        fi

        echo "[ZSH]: deleting $HOME/.zshrc"
        rm "$HOME/.zshrc"
    fi

    echo "[ZSH]: symlinking $HOME/.zshrc to $HOME/.config/zsh/.zshrc"
    ln -s "$HOME/.config/zsh/.zshrc" "$HOME/.zshrc"
fi

# powerlevel10k - zsh prompt theme
# fzf - cli fuzzy finder
# fd - find alternative (used by picker in neovim)
# eza - ls replacement with nice colors/formatting, aliased to ll
# tree - display dirs as tree, aliased to t/tt/ttt
# ast-grep - code search/lint/mod using tree-sitter's ast
# bat - cat with syntax highlighting
brew install powerlevel10k fzf fd eza tree ast-grep bat

touch ~/.hushlogin

exec zsh
